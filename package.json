    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-react": "^4.3.3",
    "acorn": "^8.14.0",
    "autoprefixer": "^10.4.20",
    "postcss-custom-properties": "^14.0.4",
